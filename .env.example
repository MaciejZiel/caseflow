APP_ENV=local
APP_NAME=CaseFlow
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=[]
TRUSTED_HOST_PATTERNS=[]
TRUST_PROXY_HEADERS=false
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE_SECONDS=0
DATABASE_URL=postgresql+psycopg://caseflow:caseflow@localhost:5432/caseflow
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
SECRET_KEY=change-this-to-a-32-byte-minimum-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
AUTH_SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=60
JOB_RETRY_BASE_DELAY_SECONDS=30
WEBHOOK_RETRY_BASE_DELAY_SECONDS=30
EMAIL_RETRY_BASE_DELAY_SECONDS=30
WORKER_POLL_INTERVAL_SECONDS=30
DOCUMENT_PROCESSING_MODE=inline
WEBHOOK_DELIVERY_MODE=sync
EMAIL_DELIVERY_MODE=sync
EMAIL_DELIVERY_BACKEND=local
INVITATION_TTL_HOURS=168
LOCAL_STORAGE_PATH=./storage
LOCAL_EMAIL_SINK_PATH=./.tmp/emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@caseflow.local
SMTP_FROM_NAME=CaseFlow
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
MAX_UPLOAD_SIZE_BYTES=10485760
